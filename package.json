{
  "name": "playwright-ai-agents-tests",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:unit": "playwright test tests/unit-tests",
    "test:integration": "playwright test tests/integration-tests",
    "test:smoke": "playwright test tests/indiaRealtime.spec.ts --project=chromium",
    "test:a11y": "playwright test tests/accessibility --project=chromium",
    "test:security": "playwright test tests/security-tests --project=chromium",
    "test:mobile": "playwright test tests/mobile.spec.ts",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --headed",
    "test:report": "npx playwright show-report",
    "mcp:server": "tsx mcp-server.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write tests/ tools/ *.ts",
    "format:check": "prettier --check tests/ tools/ *.ts"
  },
  "devDependencies": {
    "@pact-foundation/pact": "17.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.2.0",
    "axe-playwright": "^2.2.2",
    "playwright": "^1.65.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
